                if(entry){
                    let ameba_id=entry.getAttribute('data-unique-ameba-id');
                    let link_href='https://ameblo.jp/'+
                        ameba_id +'/image-'+entry_id +'-'+ image_id +'.html';
                    photo_link.innerHTML=
                        '<svg class="c" viewBox="0 0 512 512">'+
